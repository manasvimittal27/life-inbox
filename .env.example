# Copy this file to .env and fill in your key:  cp .env.example .env
OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-5-mini

# --- Gmail inbound sync (optional) ------------------------------------------
# Download an OAuth 2.0 "Desktop app" or "Web application" client secret from
# Google Cloud and save the JSON. By default the app looks for it at
# data/gmail_client_secret.json (gitignored). Override the path here if needed.
# GOOGLE_CLIENT_SECRET_FILE=data/gmail_client_secret.json
# The stored user token (gitignored); defaults to data/gmail_token.json.
# GMAIL_TOKEN_FILE=data/gmail_token.json
# OAuth requires the redirect URI to be whitelisted; for local dev add
# http://localhost:8000/api/gmail/callback to the client's authorized redirects.
